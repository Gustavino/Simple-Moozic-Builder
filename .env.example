# ============================================================
# Simple Moozic Builder - Telegram Bot secrets
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Password users must type once to unlock music submission
BOT_PASSWORD=minha_senha_secreta

# Steam account username (credentials must be cached in steamcmd)
# Leave blank if you are not using Workshop upload
STEAM_USERNAME=your_steam_username

# Spotify API credentials (required to avoid rate limiting on spotdl)
# Create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
